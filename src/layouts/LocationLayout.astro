---
// One service-area page. Content must be genuinely local (schema requires ≥3 localDetails; validate.mjs
// flags near-duplicate area pages). Never mass-produce town pages by swapping the town name.
// Layout (2026-11-20): hero + form, trust strip, intro + "working in <town>" card, real project photos,
// reviews, service cards with photos, how it works, FAQs, nearby towns, final CTA.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormHero from '../components/FormHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import JsonLd from '../components/JsonLd.astro';
import ProjectPhotos from '../components/ProjectPhotos.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Testimonials from '../components/Testimonials.astro';
import { business } from '../lib/site';
import { service } from '../lib/schema';
import { entryUrl, locations } from '../lib/content';

interface Props { entry: CollectionEntry<'locations'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = entryUrl(entry);
const town = entry.data.name;
const city = town.split(',')[0];
const nearby = (await locations()).filter((l) => l.id !== entry.id);
const tel = `tel:${business.phone}`;
const steps = [
  { t: 'Call or send the form', d: `Tell us what you want built or fixed in ${city}. Call ${business.phoneDisplay} or send the short form.` },
  { t: 'Free estimate', d: 'We go over the space, the scope and the finish you want, and give you a clear written estimate.' },
  { t: 'Our crew does the work', d: 'The owner-led crew handles every trade, start to finish, and explains each step as it happens.' },
  { t: 'Final walkthrough', d: 'We walk the finished project with you before we call it done.' },
];
---
<BaseLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.description} image={entry.data.image}>
  <JsonLd slot="head" data={service({ name: `${business.name} in ${town}`, description: entry.data.description, url, areaServed: [town] })} />
  <FormHero title={entry.data.title} lead={entry.data.description} image={entry.data.image}>
    <Breadcrumbs slot="before" items={[{ name: 'Service Areas', url: '/service-areas/' }, { name: town, url }]} />
  </FormHero>

  <section class="section">
    <div class="container">
      <ul class="trust" role="list" aria-label="At a glance">
        <li><strong>Licensed</strong><span>MI Residential Builder #262500681</span></li>
        <li><strong>Free</strong><span>Estimates, no obligation</span></li>
        <li><strong>One crew</strong><span>Owner-led, start to finish</span></li>
        <li><strong>Local</strong><span>Based in Holland, MI</span></li>
      </ul>

      <div class="intro">
        <div>
          <h2 class="sec-kw">Remodeling in {town}</h2>
          <p class="sec-big">Your local remodeling crew in {city}</p>
          <div class="prose"><Content /></div>
          <div class="intro__cta">
            <a class="btn btn--primary" href={tel}>Call {business.phoneDisplay}</a>
            <a class="btn btn--outline" href="#estimate">Get a free estimate</a>
          </div>
        </div>
        <aside class="local" aria-labelledby="local-h">
          <h2 id="local-h" class="local__h">Working in {city}</h2>
          <ul class="local__list" role="list">
            {entry.data.localDetails.map((d) => (
              <li>
                <svg class="local__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" fill="currentColor"/></svg>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="work-h">
    <div class="container">
      <h2 id="work-h" class="sec-kw">Our work</h2>
      <p class="sec-big">Real projects by our crew</p>
      <p class="lead">Photos from our own jobs across West Michigan, from open framing to the finished room.</p>
      <ProjectPhotos tabs />
    </div>
  </section>

  <Testimonials headline={`What homeowners say about working with us`} surface={false} />

  <section class="section section--surface" aria-labelledby="svc-h">
    <div class="container">
      <h2 id="svc-h" class="sec-kw">Services in {town}</h2>
      <p class="sec-big">Everything your project needs</p>
      <ServiceCards compact />
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <h2 id="how-h" class="sec-kw">How it works</h2>
      <p class="sec-big">From first call to final walkthrough</p>
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li><span class="steps__n" aria-hidden="true">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
        ))}
      </ol>
      <div class="steps__cta">
        <a class="btn btn--primary" href={tel}>Call {business.phoneDisplay}</a>
        <a class="btn btn--outline" href="#estimate">Send the form</a>
      </div>
    </div>
  </section>

  {entry.data.faqs.length > 0 && <section class="section section--surface"><div class="container"><FaqList faqs={entry.data.faqs} title={`Remodeling FAQs: ${town}`} headline="Questions before you start?" /></div></section>}

  {nearby.length > 0 && (
    <section class="section" aria-labelledby="near-h">
      <div class="container">
        <h2 id="near-h" class="sec-kw">Also serving</h2>
        <p class="sec-big">Nearby towns</p>
        <ul class="nearby" role="list">{nearby.map((l) => <li><a href={entryUrl(l)}>{l.data.name}</a></li>)}</ul>
      </div>
    </section>
  )}

  <CtaBand strip kw="Free estimate" title={`Planning a project in ${city}?`} />
</BaseLayout>
<style>
  .trust { list-style: none; padding: 0; margin: 0 0 var(--space-7); display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .trust li { display: grid; gap: 2px; padding: var(--space-4); border: 1px solid var(--color-border); border-top: 3px solid var(--color-accent); background: var(--color-surface); }
  .trust strong { font-family: var(--font-heading); font-size: 1.6rem; text-transform: uppercase; line-height: 1; }
  .trust span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .intro { display: grid; gap: var(--space-6); align-items: start; }
  @media (min-width: 60rem) { .intro { grid-template-columns: 1.3fr 1fr; } }
  .intro__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .local { background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); padding: var(--space-5); }
  .local__h { font-size: 1.6rem; margin: 0 0 var(--space-4); }
  .local__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); }
  .local__list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; color: var(--color-text-muted); }
  .local__icon { width: 1.4rem; height: 1.4rem; color: var(--color-accent); margin-top: 2px; }
  .steps { list-style: none; padding: 0; margin: var(--space-5) 0 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .steps__n { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--color-accent); color: var(--color-on-accent); }
  .steps h3 { margin: 0 0 var(--space-1); font-size: 1.4rem; }
  .steps p { margin: 0; color: var(--color-text-muted); }
  .steps__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .nearby { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .nearby a { display: inline-block; padding: 8px 16px; border: 1px solid var(--color-border); text-decoration: none; color: var(--color-text); }
  .nearby a:hover { border-color: var(--color-accent); color: var(--color-accent); }
</style>
