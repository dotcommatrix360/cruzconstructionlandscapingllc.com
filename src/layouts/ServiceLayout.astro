---
// One service page: photo hero with the estimate form, the service copy, FAQs, related services, CTA.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormHero from '../components/FormHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import JsonLd from '../components/JsonLd.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { business } from '../lib/site';
import { service, faqPage } from '../lib/schema';
import { entryUrl, services, locations } from '../lib/content';
import ProjectPhotos from '../components/ProjectPhotos.astro';
import { serviceCategory } from '../lib/projects';

interface Props { entry: CollectionEntry<'services'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = entryUrl(entry);
const others = (await services()).filter((s) => s.id !== entry.id);
const name = entry.data.title;
const lower = name.toLowerCase();
const cat = serviceCategory[entry.id];
const areas = await locations();
const faqs = entry.data.faqs;
// FAQPage JSON-LD mirrors exactly what is visible: answer + points + takeaway.
const faqSchema = faqPage(faqs.map((f) => ({ question: f.question, answer: [f.answer, ...f.points, f.takeaway].filter(Boolean).join(' ') })));
const steps = [
  { t: 'Call or send the form', d: `Tell us about your ${lower} project. Call ${business.phoneDisplay} or send the three-field form above.` },
  { t: 'Free estimate', d: 'We talk through the space, the scope and the look you want, and give you a free estimate with no obligation.' },
  { t: 'Our crew does the work', d: 'The owner and our own crew do the work, and we explain each step as it happens.' },
  { t: 'Final walkthrough', d: 'We walk through the finished work with you before we call the job done.' },
];
---
<BaseLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.description} image={entry.data.image}>
  <JsonLd slot="head" data={service({ name: entry.data.title, description: entry.data.description, url })} />
  {faqSchema && <JsonLd slot="head" data={faqSchema} />}
  <FormHero title={`${entry.data.title} in Holland, MI`} headline={entry.data.headline} lead={`${entry.data.summary} Local and owner-operated in Holland, MI.`} image={entry.data.image} formTitle={`Free ${entry.data.title.toLowerCase()} estimate`}>
    <Breadcrumbs slot="before" items={[{ name: entry.data.title, url }]} />
  </FormHero>


  <section class="section section--light">
    <div class="container svc-page">
      <div class="prose"><Content /></div>
      <aside class="svc-aside" aria-label="Contact">
        {entry.data.image && <ResponsiveImage src={entry.data.image} alt={entry.data.imageAlt ?? ''} sizes="(min-width: 60rem) 24rem, 100vw" widths={[480, 960]} />}
        <div class="svc-aside__body">
          <p class="svc-aside__h">Talk to the owner</p>
          <p>Local, owner-operated and licensed in Michigan. Free estimates, 7am to 5pm.</p>
          <a class="btn btn--primary" href={`tel:${business.phone}`}>Call {business.phoneDisplay}</a>
          <a class="btn btn--secondary" href="#estimate">Send the estimate form</a>
        </div>
      </aside>
    </div>
  </section>

  {cat && (
    <section class="section" aria-labelledby="pp-h">
      <div class="container">
        <h2 id="pp-h" class="sec-kw">{name} projects in Holland, MI</h2>
        <p class="sec-big">See the kind of work we build</p>
        <ProjectPhotos only={cat} />
      </div>
    </section>
  )}

  <section class="section section--light" aria-labelledby="why-h">
    <div class="container why">
      <div>
        <h2 id="why-h" class="sec-kw">Why Holland homeowners choose Cruz Construction for {lower}</h2>
        <p class="sec-big">One local crew you can talk to</p>
        <p class="lead">You deal with the owner from the first call to the final walkthrough, not a sales rep and a chain of subcontractors.</p>
      </div>
      <ul class="why__list" role="list">
        <li><strong>Licensed in Michigan</strong><span>Cruz Construction &amp; Landscaping LLC holds a Michigan Builders License.</span></li>
        <li><strong>Local &amp; owner-operated</strong><span>Based in the Holland area and serving West Michigan.</span></li>
        <li><strong>20+ projects completed</strong><span>Homeowners trust the quality they see in our previous projects.</span></li>
        <li><strong>We explain as we go</strong><span>You know what is being done and why, at every step.</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="how-h">
    <div class="container">
      <h2 id="how-h" class="sec-kw">How {lower} works with Cruz Construction in Holland</h2>
      <p class="sec-big">From free estimate to finished project</p>
      <ol class="steps" role="list">
        {steps.map((st, i) => <li><span class="steps__n" aria-hidden="true">{i + 1}</span><div><h3>{st.t}</h3><p>{st.d}</p></div></li>)}
      </ol>
      <p class="steps__cta"><a class="btn btn--primary" href="#estimate">Get your free {lower} estimate</a> <a class="btn btn--secondary" href={`tel:${business.phone}`}>Call {business.phoneDisplay}</a></p>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section--light" aria-labelledby="exp-h">
      <div class="container">
        <h2 id="exp-h" class="sec-kw">{name} in Holland, MI, explained</h2>
        <p class="sec-big">Honest answers before you start</p>
        <div class="explained">
          {faqs.map((f) => (
            <article class="explained__item">
              <h3>{f.question}</h3>
              <p>{f.answer}</p>
              {f.points.length > 0 && <ul>{f.points.map((p) => <li>{p}</li>)}</ul>}
              {f.takeaway && <p class="explained__take"><strong>Key takeaway:</strong> {f.takeaway}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface" aria-labelledby="area-h">
    <div class="container why">
      <div>
        <h2 id="area-h" class="sec-kw">{name} in Holland, MI &amp; West Michigan</h2>
        <p class="sec-big">Proudly serving Holland and surrounding areas</p>
      </div>
      <div class="stack">
        <p>Cruz Construction &amp; Landscaping is based in the Holland area and does {lower} across West Michigan, on both the Ottawa County and Allegan County sides of Holland. Every project gets the same licensed, owner-led crew.</p>
        <ul class="area-list" role="list">
          {areas.map((a) => <li><a href={entryUrl(a)}>Remodeling in {a.data.name} &rarr;</a></li>)}
          <li><a href="/service-areas/">All service areas &rarr;</a></li>
        </ul>
        <p>Not sure we cover your town? Call <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2 class="sec-kw">More home remodeling services in Holland &amp; West Michigan</h2>
      <p class="sec-big">Planning more than one project?</p>
      <ul class="others" role="list">
        {others.map((s) => (
          <li>
            <a href={entryUrl(s)}>
              {s.data.image && <ResponsiveImage src={s.data.image} alt="" sizes="(min-width: 64rem) 16rem, 50vw" widths={[480]} />}
              <span>{s.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand kw={`Free ${entry.data.title.toLowerCase()} estimate in Holland, MI`} title={`Ready to talk about ${entry.data.title.toLowerCase()}?`} text="Free estimate, no obligation. Call or send the three-field form." />
</BaseLayout>
<style>
  .svc-page { display: grid; gap: var(--space-7); }
  @media (min-width: 60rem) { .svc-page { grid-template-columns: 1fr 22rem; align-items: start; } .svc-aside { position: sticky; top: calc(var(--header-h) + var(--space-5)); } }
  .svc-aside { border: 1px solid var(--color-border); background: var(--color-surface); }
  .svc-aside :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .svc-aside__body { padding: var(--space-5); display: grid; gap: var(--space-3); }
  .svc-aside__body p { margin: 0; color: var(--color-text-muted); }
  .svc-aside__h { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: 1.75rem; color: var(--color-text) !important; }
  .explained { display: grid; gap: var(--space-4); margin-top: var(--space-5); }
  @media (min-width: 60rem) { .explained { grid-template-columns: 1fr 1fr; } }
  .explained__item { border: 1px solid var(--color-border); background: var(--color-surface); padding: var(--space-5) var(--space-6); }
  .explained__item h3 { font-size: 1.5rem; margin-bottom: var(--space-3); }
  .explained__item p, .explained__item li { color: var(--color-text-muted); }
  .explained__item ul { padding-left: 1.2em; margin-bottom: var(--space-3); }
  .explained__take { margin: 0; padding-top: var(--space-3); border-top: 1px solid var(--color-border); color: var(--color-text) !important; }
  .explained__take strong { color: var(--color-accent-text); }
  .area-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); font-weight: 600; }
  .why { display: grid; gap: var(--space-6); }
  @media (min-width: 60rem) { .why { grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; } }
  .why__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .why__list li { display: grid; gap: 2px; padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); background: var(--color-surface); }
  .why__list strong { font-family: var(--font-heading); font-size: 1.4rem; text-transform: uppercase; }
  .why__list span { color: var(--color-text-muted); }
  .steps { list-style: none; padding: 0; margin: var(--space-5) 0 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .steps__n { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--color-accent); color: var(--color-on-accent); }
  .steps h3 { margin: 0 0 var(--space-1); font-size: 1.4rem; }
  .steps p { margin: 0; color: var(--color-text-muted); }
  .steps__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .others { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); }
  .others a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; color: var(--color-text); text-decoration: none; border: 1px solid var(--color-border); }
  .others :global(picture), .others :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .others a::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgb(13 13 12 / 90%)); }
  .others span { position: absolute; left: var(--space-3); right: var(--space-3); bottom: var(--space-3); z-index: 1; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: 1.3rem; line-height: 1.05; }
  .others a:hover span { color: var(--color-accent-text); }
</style>
