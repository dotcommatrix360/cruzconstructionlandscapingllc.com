---
// LeadConnector (GoHighLevel) chat widget, loaded from BaseLayout on every page except those passing noChat
// (/feedback/, /marketing-form/). SMS opt-in happens in its consent box (the A2P 10DLC campaign was approved on it)
// and, since 2026-11-19, also in the GHL Website Form (EstimateForm.astro), which carries the A2P consent checkboxes.
// Config: site.config.json → integrations.chatWidget.
// Elements with [data-open-chat] open the chat window once the widget is ready; #estimate links go to the form.
import { config } from '../lib/site';
const w = config.integrations.chatWidget;
const id = w?.provider === 'leadconnector' ? w.widgetId : '';
---
{id && (
  <>
    <script is:inline src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id={id} data-source="WEB_USER" defer></script>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-open-chat]');
        var cw = window.leadConnector && window.leadConnector.chatWidget;
        if (!el || !cw || typeof cw.openWidget !== 'function') return;
        e.preventDefault();
        cw.openWidget();
      });
    </script>
  </>
)}
