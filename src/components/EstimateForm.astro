---
// Estimate form: the GoHighLevel "Website Form" (site.config.json → integrations.form), embedded inline.
// Submissions go straight into GHL. The form carries its own A2P 10DLC SMS consent checkboxes, so no consent
// text is added here. Keeps the card wrapper and title so the home, contact and FormHero layouts are unchanged.
import GhlForm from './GhlForm.astro';
import { config, business } from '../lib/site';
interface Props { id?: string; title?: string; headingLevel?: 2 | 3 }
const { id = 'estimate', title = 'Get a free estimate', headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const form = config.integrations.form as { formId?: string; formName?: string; height?: number };
---
<div class="estimate-form" id={id}>
  <H class="estimate-form__title">{title}</H>
  <p class="estimate-form__sub">Free estimate, no obligation. Prefer to talk? Call <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>.</p>
  <GhlForm formId={form.formId || '8W8Q7JOUkFQHxrIhMbgy'} formName={form.formName || 'Website Form'} height={form.height || 620} />
</div>
<style>
  .estimate-form { background: var(--color-surface); border: 1px solid var(--color-border); padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); box-shadow: var(--shadow-lg); min-width: 0; }
  .estimate-form__title { font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem); margin-bottom: var(--space-1); }
  .estimate-form__sub { color: var(--color-text-muted); margin-bottom: var(--space-5); font-size: var(--text-sm); }
</style>
