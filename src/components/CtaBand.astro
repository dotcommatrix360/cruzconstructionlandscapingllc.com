---
// Conversion band: one primary action (from site.config.json → cta) + tap-to-call.
import { config, business } from '../lib/site';
// kw = keyword heading (small, SEO); title = big conversion line. Without kw, title is the heading.
interface Props { title: string; text?: string; kw?: string; strip?: boolean }
const { title, text, kw, strip = false } = Astro.props;
---
<section class:list={["section", strip ? "strip" : "section--inverse", "cta-band"]}>
  <div class="container cta-band__inner">
    <div>
      {kw ? <><h2 class="sec-kw">{kw}</h2><p class="sec-big">{title}</p></> : <h2>{title}</h2>}
      {text && <p class="lead">{text}</p>}
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={config.cta.url}>{config.cta.label}</a>
      {business.phone && <a class="btn btn--secondary" href={`tel:${business.phone}`}>Call {business.phoneDisplay || business.phone}</a>}
    </div>
  </div>
</section>
<style>
  .cta-band__inner { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 60rem) { .cta-band__inner { grid-template-columns: 2fr 1fr; } }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cta-band h2 { margin-bottom: var(--space-2); }
</style>
