---
// Grid of example project photos (not links). Optional category tabs on the home page.
import ResponsiveImage from './ResponsiveImage.astro';
import { projects, categories, type Category } from '../lib/projects';
interface Props { only?: Category; tabs?: boolean }
const { only, tabs = false } = Astro.props;
const list = only ? projects.filter((p) => p.cat === only) : projects;
const label = (c: Category) => categories.find((x) => x.id === c)!.label;
---
{tabs && (
  <div class="tabs" role="group" aria-label="Filter project photos" data-tabs hidden>
    <button type="button" aria-pressed="true" data-filter="all">All projects</button>
    {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c.id}>{c.label}</button>)}
  </div>
)}
<ul class="pp" role="list" data-projects>
  {list.map((p) => (
    <li class="pp__item" data-cat={p.cat}>
      <figure>
        <ResponsiveImage src={p.img} alt={p.alt} sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw" widths={[480, 960]} />
        <figcaption><small>{label(p.cat)}</small><strong>{p.title}</strong></figcaption>
      </figure>
    </li>
  ))}
</ul>
{tabs && (
  <script>
    const tabs = document.querySelector<HTMLElement>('[data-tabs]');
    const items = document.querySelectorAll<HTMLElement>('[data-projects] [data-cat]');
    if (tabs) {
      tabs.hidden = false;
      tabs.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
        if (!btn) return;
        for (const b of tabs.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === btn));
        const f = btn.dataset.filter;
        for (const it of items) it.hidden = f !== 'all' && it.dataset.cat !== f;
      });
    }
  </script>
)}
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
  .tabs[hidden] { display: none; }
  .tabs button { font: inherit; font-weight: 600; font-size: var(--text-sm); padding: var(--space-2) var(--space-4); min-height: 44px; border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text); cursor: pointer; }
  .tabs button:hover { border-color: var(--color-accent); color: var(--color-accent-text); }
  .tabs button[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .pp { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .pp { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .pp { grid-template-columns: repeat(3, 1fr); } }
  .pp__item[hidden] { display: none; }
  .pp figure { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  .pp :global(picture), .pp :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pp figure::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgb(13 13 12 / 88%)); }
  .pp figcaption { position: absolute; left: var(--space-4); right: var(--space-4); bottom: var(--space-3); z-index: 1; display: grid; }
  .pp figcaption small { color: var(--color-accent-text); font-size: var(--text-sm); font-weight: 600; }
  .pp figcaption strong { font-family: var(--font-heading); font-size: 1.5rem; text-transform: uppercase; line-height: 1.1; }
</style>
