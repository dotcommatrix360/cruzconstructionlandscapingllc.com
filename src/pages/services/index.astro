---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services, entryUrl } from '../../lib/content';
const list = await services();
const more = ['Insulation', 'Drywall hanging & finishing', 'Painting', 'Tile & LVP flooring', 'Custom tile showers', 'Kitchen backsplash', 'Carpentry & trim work', 'Door replacement', 'Cabinet install', 'Drop ceiling install'];
import ResponsiveImage from '../../components/ResponsiveImage.astro';
---
<BaseLayout title="Remodeling Services in Holland, MI" description="Kitchen, bathroom and basement remodeling plus drywall, painting, tile, LVP flooring, carpentry and drop ceilings in Holland, MI and West Michigan.">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Services', url: '/services/' }]} />
      <h1>Remodeling services in Holland, MI</h1>
      <p class="lead measure">Remodeling for kitchens, bathrooms and basements, with the trades done in-house.</p>
      <ul class="svc" role="list">
        {list.map((s, i) => (
          <li>
            {s.data.image && <ResponsiveImage src={s.data.image} alt={s.data.imageAlt ?? ''} sizes="(min-width: 72rem) 23rem, 100vw" widths={[480, 960]} priority={i === 0} />}
            <h2><a href={entryUrl(s)}>{s.data.title}</a></h2>
            <p>{s.data.summary}</p>
            <a href={entryUrl(s)}>Read more &rarr;</a>
          </li>
        ))}
      </ul>
      <h2 class="h2s">Everything else we do</h2>
      <p class="measure">Beyond full remodels, the crew takes on individual trades, whether it is one tile shower, a run of trim, or a ceiling. Each one is done by the same Michigan-licensed builder who runs the larger projects, so the standard does not change with the size of the job.</p>
      <ul class="chips" role="list">{more.map((m) => <li>{m}</li>)}</ul>
    </div>
  </section>
  <CtaBand title="Tell us about your project" text="Call 616-502-1874 or send us a note." />
</BaseLayout>
<style>
  .svc { list-style: none; padding: 0; margin: var(--space-7) 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .svc li { border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); background: var(--color-surface); padding: 0 0 var(--space-6); }
  .svc li > :not(picture) { padding-inline: var(--space-6); }
  .svc :global(img) { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; margin-bottom: var(--space-5); }
  .svc h2 { font-size: 2rem; }
  .svc h2 a { color: var(--color-text); text-decoration: none; }
  .svc p { color: var(--color-text-muted); }
  .h2s { font-size: 1.75rem; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chips li { border: 1px solid var(--color-border); padding: var(--space-2) var(--space-4); border-radius: 999px; background: var(--color-surface); }
</style>
