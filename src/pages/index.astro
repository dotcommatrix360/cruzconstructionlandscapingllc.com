---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CtaBand from '../components/CtaBand.astro';
import { config, business } from '../lib/site';
import { localBusiness } from '../lib/schema';
import { services, entryUrl } from '../lib/content';

const featured = await services();
const more = [
  'Insulation', 'Drywall hanging & finishing', 'Painting', 'Tile & LVP flooring',
  'Custom tile showers', 'Kitchen backsplash', 'Carpentry & trim work', 'Door replacement',
  'Cabinet install', 'Drop ceiling install',
];
const social = (business.sameAs || []).map((url) => {
  const host = new URL(url).hostname.replace(/^www\./, '');
  return { url, name: host.startsWith('facebook') ? 'Facebook' : host.startsWith('instagram') ? 'Instagram' : 'TikTok' };
});
---
<BaseLayout fullTitle title="Cruz Construction | Kitchen, Bath & Basement Remodeling" description="Michigan-licensed builder serving Holland and West Michigan. Kitchen, bathroom and basement remodeling plus drywall, tile, flooring and carpentry.">
  <JsonLd slot="head" data={localBusiness()} />

  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Serving Holland, MI &amp; West Michigan</p>
        <h1>Kitchens, bathrooms and basements, built right.</h1>
        <p class="lead">Cruz Construction &amp; Landscaping is a Michigan-licensed builder. One small crew handles the carpentry, drywall, tile and paint, and explains the work as it happens.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={config.cta.url}>{config.cta.label}</a>
          <a class="btn btn--secondary" href={`tel:${business.phone}`}>Call {business.phoneDisplay}</a>
        </div>
      </div>
      <aside class="estimate" aria-labelledby="est-h">
        <h2 id="est-h">Tell us what you are building</h2>
        <p>Call or email with your project. We will get back to you.</p>
        <a class="btn btn--primary" href={`tel:${business.phone}`}>Call {business.phoneDisplay}</a>
        <a class="btn btn--secondary" href={`mailto:${business.email}?subject=Estimate%20request`}>Send us an email</a>
        <p class="estimate__hours">Working hours: 7am to 5pm</p>
      </aside>
    </div>
  </section>

  <section class="facts" aria-label="At a glance">
    <div class="container facts__grid">
      <p><strong>Licensed</strong><span>Michigan Builders License</span></p>
      <p><strong>20</strong><span>clients served so far</span></p>
      <p><strong>2</strong><span>person crew, hands-on</span></p>
      <p><strong>1 yr</strong><span>in business as Cruz Construction</span></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we build</p>
        <h2>Three projects we do most</h2>
      </div>
      <ol class="feature-list" role="list">
        {featured.map((s, i) => (
          <li>
            <span class="feature-list__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={entryUrl(s)}>{s.data.title}</a></h3>
              <p>{s.data.summary}</p>
            </div>
            <a class="feature-list__go" href={entryUrl(s)} aria-label={`${s.data.title} details`}>View &rarr;</a>
          </li>
        ))}
      </ol>
      <h3 class="more-h">Also on the crew's list</h3>
      <ul class="chips" role="list">{more.map((m) => <li>{m}</li>)}</ul>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container story">
      <div>
        <p class="eyebrow">Our story</p>
        <h2>Learned on rental properties. Sharpened in industrial work.</h2>
      </div>
      <div class="stack">
        <p>Growing up, I helped remodel and turn over rental properties. In my 20s I moved into industrial work, where I built strong hands-on and troubleshooting skills.</p>
        <p>In 2025 I earned my Michigan Builder's license and started Cruz Construction &amp; Landscaping LLC.</p>
        <p>Homeowners trust us because they can see the quality of our earlier projects, and because we explain the work as it is being done.</p>
        <p><a class="btn btn--secondary" href="/about/">More about us</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our work</p>
        <h2>See recent projects</h2>
        <p class="lead">We post our projects on social media. Have a look at the work before you call.</p>
      </div>
      <ul class="social" role="list">
        {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener"><span>{s.name}</span><small>Recent projects &rarr;</small></a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand title="Have a project in mind?" text="Call 616-502-1874 or send us a note and tell us what you want built." />
</BaseLayout>
<style>
  .hero { padding-block: clamp(2.5rem, 2rem + 4vw, 6rem); background:
    linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 48px 48px,
    linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 48px 48px,
    var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .hero__grid { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 60rem) { .hero__grid { grid-template-columns: 1.25fr 1fr; } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .estimate { background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); padding: var(--space-6); display: grid; gap: var(--space-4); box-shadow: var(--shadow-lg); }
  .estimate h2 { font-size: 2rem; margin: 0; }
  .estimate p { margin: 0; color: var(--color-text-muted); }
  .estimate .btn { overflow-wrap: anywhere; text-align: center; }
  .estimate__hours { font-size: var(--text-sm); }
  .facts { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .facts__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-5); padding-block: var(--space-6); }
  .facts p { margin: 0; display: grid; gap: 2px; }
  .facts strong { font-family: var(--font-heading); font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem); line-height: 1; text-transform: uppercase; color: var(--color-accent); }
  .facts span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .feature-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .feature-list li { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-5); align-items: center; padding-block: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .feature-list__n { font-family: var(--font-heading); font-size: clamp(2.5rem, 2rem + 2vw, 4rem); color: var(--color-accent); line-height: 1; }
  .feature-list h3 { margin: 0 0 var(--space-2); font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem); }
  .feature-list h3 a { color: var(--color-text); text-decoration: none; }
  .feature-list h3 a:hover { color: var(--color-accent); }
  .feature-list p { margin: 0; color: var(--color-text-muted); max-width: 52ch; }
  .feature-list__go { font-weight: 600; white-space: nowrap; }
  @media (max-width: 40rem) { .feature-list li { grid-template-columns: auto 1fr; } .feature-list__go { grid-column: 2; } }
  .more-h { margin-top: var(--space-7); font-size: 1.25rem; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chips li { border: 1px solid var(--color-border); padding: var(--space-2) var(--space-4); border-radius: 999px; background: var(--color-surface); }
  .story { display: grid; gap: var(--space-6); }
  @media (min-width: 60rem) { .story { grid-template-columns: 1fr 1.1fr; gap: var(--space-8); } }
  .social { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .social a { display: grid; gap: var(--space-2); padding: var(--space-6); border: 1px solid var(--color-border); background: var(--color-surface); text-decoration: none; color: var(--color-text); transition: border-color var(--duration) var(--ease); }
  .social a:hover { border-color: var(--color-accent); }
  .social span { font-family: var(--font-heading); font-size: 2rem; text-transform: uppercase; font-weight: 700; }
  .social small { color: var(--color-accent); font-size: var(--text-sm); }
</style>
