---
// Home: follows the approved Concept 1 (dark) section order. Facts only from the client's Fillout intake.
// Photos are stock (owner's instruction, until real project photos arrive) and are labelled as examples.
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import EstimateForm from '../components/EstimateForm.astro';
import FaqList from '../components/FaqList.astro';
import ProjectPhotos from '../components/ProjectPhotos.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { business } from '../lib/site';
import { services, locations, entryUrl } from '../lib/content';

import heroImg from '../assets/images/hero-carpentry-job-site.jpg';
import kitchenImg from '../assets/images/kitchen-remodel-island.jpg';
import bathImg from '../assets/images/bathroom-tile-shower.jpg';
import carpentryImg from '../assets/images/carpentry-measuring-board.jpg';
import drywallImg from '../assets/images/interior-paint-roller.jpg';
import sawImg from '../assets/images/carpenter-circular-saw.jpg';

const list = await services();
const areas = await locations();
const tel = `tel:${business.phone}`;




const steps = [
  { t: 'Call or send the form', d: `Tell us what you want built or fixed. Call ${business.phoneDisplay} or send the three-field form.` },
  { t: 'We talk through the project', d: 'We go over the space, the scope and what you want it to look like, and give you a free estimate.' },
  { t: 'One crew does the work', d: 'Our own crew handles the trades, start to finish, and explains each step as it happens.' },
  { t: 'Final walkthrough', d: 'We walk the finished project with you before we call it done.' },
];

const faqs = [
  { question: 'Are you licensed?', answer: 'Yes. Cruz Construction & Landscaping LLC holds a Michigan Builders License.' },
  { question: 'Where do you work?', answer: 'We serve Holland, MI and West Michigan. If you are not sure we cover your town, call 616-502-1874 and ask.' },
  { question: 'What services do you offer?', answer: 'Kitchen remodeling, bathroom remodeling and basement finishing, plus insulation, drywall hanging and finishing, painting, tile and LVP flooring, custom tile showers and kitchen backsplashes, carpentry and trim work, door replacement, cabinet installation and drop ceiling installation.' },
  { question: 'Do you take smaller jobs?', answer: 'Yes. Along with full remodels we take on single trades, such as one tile shower, a backsplash, new flooring, a run of trim or a drop ceiling.' },
  { question: 'Who does the work?', answer: 'Our own crew, led by the owner. We do not hand your project off to a chain of subcontractors.' },
  { question: 'What are your working hours?', answer: 'We work 7am to 5pm.' },
  { question: 'How do I get an estimate?', answer: `Call ${business.phoneDisplay}, email ${business.email}, or send the estimate form on this page. Estimates are free.` },
];
---
<BaseLayout fullTitle title="Remodeling Contractor in Holland, MI | Cruz Construction" description="Kitchen, bathroom and basement remodeling in Holland, MI and West Michigan. Licensed Michigan builder for drywall, tile, LVP flooring and carpentry.">

  <!-- 1. Hero + estimate form + trust bar -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__bg" aria-hidden="true">
      <ResponsiveImage src={heroImg} alt="" priority sizes="100vw" widths={[640, 960, 1300]} />
    </div>
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h" class="hero__kw">Remodeling Contractor in Holland, MI</h1>
        <p class="hero__big">Your dream home or dream project can be a reality.</p>
        <p class="hero__lead">Kitchens, bathrooms, basements and every trade behind them. From the first cut to the final walkthrough, one local, licensed crew handles it. Tell us what you are building and we get back to you.</p>
        <ul class="chips" role="list">
          {list.slice(0, 6).map((s) => <li><a href={entryUrl(s)}>{s.data.title}</a></li>)}
          <li><a href="#services">+ {list.length - 6} more services</a></li>
        </ul>
        <div class="hero__call">
          <a class="btn btn--primary btn--big" href={tel}>Call {business.phoneDisplay}</a>
          <span>or send the form and we will get back to you</span>
        </div>
      </div>
      <EstimateForm id="hero-estimate" />
    </div>
    <div class="container">
      <ul class="stats" role="list" aria-label="At a glance">
        <li><strong>Licensed</strong><span>Michigan Builders License</span></li>
        <li><strong>20+</strong><span>Projects completed</span></li>
        <li><strong>Free</strong><span>Estimates, no obligation</span></li>
        <li><strong>Local</strong><span>Owner-operated in Holland, MI</span></li>
      </ul>
    </div>
    <div class="container"><div class="ruler" aria-hidden="true"></div></div>
  </section>

  <!-- 2. Our projects: photos filtered by category -->
  <section class="section" id="projects" aria-labelledby="work-h">
    <div class="container">
      <div class="head-row">
        <div>
          <h2 id="work-h" class="sec-kw">Remodeling projects in Holland, MI</h2>
          <p class="sec-big">Dream homes, built one project at a time</p>
        </div>
        <a class="btn btn--outline" href="#estimate">Start your project</a>
      </div>
      <ProjectPhotos tabs />
    </div>
  </section>

  <BeforeAfter />

  <!-- 3. Services (photo cards) -->
  <section class="section section--light" id="services" aria-labelledby="svc-h">
    <div class="container">
      <div class="head-row">
        <div>
          <h2 id="svc-h" class="sec-kw">Home remodeling services in Holland &amp; West Michigan</h2>
          <p class="sec-big">Everything your project needs, from one crew</p>
          <p class="lead">Kitchens, bathrooms and basements, and every trade behind them, done by our own crew.</p>
        </div>
        <a class="btn btn--outline" href="#estimate">Get a free estimate</a>
      </div>
      <ul class="svc" role="list">
        {list.map((s, i) => (
          <li class:list={['svc__card', i < 3 && 'svc__card--lg']}>
            {s.data.image && <ResponsiveImage src={s.data.image} alt={s.data.imageAlt ?? ''} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" widths={[480, 960]} />}
            <div class="svc__body">
              <h3><a href={entryUrl(s)}>{s.data.title}</a></h3>
              <p>{s.data.summary}</p>
              <span class="svc__go" aria-hidden="true">See {s.data.title.toLowerCase()} &rarr;</span>
            </div>
          </li>
        ))}
        <li class="svc__card svc__card--cta">
          <div class="svc__body">
            <p class="svc__cta-h">Not sure where to start?</p>
            <p>Tell us what you want built or fixed. The estimate is free.</p>
            <a class="btn btn--primary btn--big" href={tel}>Call {business.phoneDisplay}</a>
            <a class="svc__alt" href="#estimate">or send the 3-field form &rarr;</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 4. Why us / about the owner -->
  <section class="section" aria-labelledby="about-h">
    <div class="container split">
      <div class="split__media">
        <ResponsiveImage src={sawImg} alt="Carpenter cutting a board with a circular saw" sizes="(min-width: 60rem) 45vw, 100vw" widths={[480, 960, 1400]} />
        <div class="badge"><strong>Licensed</strong><span>Michigan Builders License</span></div>
      </div>
      <div class="stack">
        <h2 id="about-h" class="sec-kw">Licensed, local remodeling contractor in Holland, MI</h2>
        <p class="sec-big">Learned on rental properties. Sharpened in industrial work.</p>
        <p>Growing up, I helped remodel and turn over rental properties. In my 20s I got into industrial work, where I gained great hands-on and troubleshooting skills. In 2025 I decided to pursue my Michigan Builder's license and start my own construction company.</p>
        <ul class="checks" role="list">
          <li><strong>Quality you can see.</strong> Homeowners trust us because of the work in our previous projects.</li>
          <li><strong>We explain as we go.</strong> You know what is being done and why, at every step.</li>
          <li><strong>One crew, start to finish.</strong> No chain of subcontractors.</li>
          <li><strong>Local and owner-operated.</strong> The owner is on your project, not a sales rep.</li>
          <li><strong>Licensed in Michigan.</strong> Michigan Builders License.</li>
        </ul>
        <div class="actions">
          <a class="btn btn--primary btn--big" href="#estimate">Get a free estimate</a>
          <a class="btn btn--outline" href="/about/">About us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band with photo -->
  <section class="photo-cta" aria-label="Call for a free estimate">
    <div class="photo-cta__bg" aria-hidden="true"><ResponsiveImage src={drywallImg} alt="" sizes="100vw" widths={[640, 1400]} /></div>
    <div class="container photo-cta__inner">
      <p class="photo-cta__h">Have a project in mind? Call <a href={tel}>{business.phoneDisplay}</a></p>
      <a class="btn btn--primary btn--big" href="#estimate">Get a free estimate</a>
    </div>
  </section>

  <!-- 5. How it works -->
  <section class="section section--light" aria-labelledby="how-h">
    <div class="container split split--rev">
      <div class="stack">
        <h2 id="how-h" class="sec-kw">How a remodel with Cruz Construction works in Holland</h2>
        <p class="sec-big">From free estimate to finished project</p>
        <ol class="steps" role="list">
          {steps.map((s, i) => (
            <li><span class="steps__n" aria-hidden="true">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
          ))}
        </ol>
        <div class="actions"><a class="btn btn--primary btn--big" href="#estimate">Start with step 1</a></div>
      </div>
      <div class="split__media">
        <ResponsiveImage src={carpentryImg} alt="Carpenter measuring a board before cutting" sizes="(min-width: 60rem) 45vw, 100vw" widths={[480, 960, 1200]} />
      </div>
    </div>
  </section>

  <!-- 6. Reviews (no quotes until the client gives permission to publish them) -->
  <section class="section section--surface" aria-labelledby="rev-h">
    <div class="container reviews">
      <div>
        <h2 id="rev-h" class="sec-kw">Reviews from Holland &amp; West Michigan homeowners</h2>
        <p class="sec-big">See what homeowners say</p>
        <p class="lead">20+ projects completed. Read homeowner reviews and see recent projects on our Facebook page.</p>
      </div>
      <div class="reviews__links">
        {(business.sameAs || []).map((u) => {
          const name = u.includes('facebook') ? 'Facebook' : u.includes('instagram') ? 'Instagram' : 'TikTok';
          return <a class="social" href={u} target="_blank" rel="noopener"><strong>{name}</strong><small>{name === 'Facebook' ? 'Reviews & recent projects' : 'Recent projects'} &rarr;</small></a>;
        })}
      </div>
    </div>
  </section>

  <!-- 7. Service areas -->
  <section class="section section--light" aria-labelledby="area-h">
    <div class="container split">
      <div class="split__media">
        <ResponsiveImage src={kitchenImg} alt="Remodeled kitchen with an island and pendant lights" sizes="(min-width: 60rem) 45vw, 100vw" widths={[480, 960]} />
      </div>
      <div class="stack">
        <h2 id="area-h" class="sec-kw">Service areas: Holland, MI, Ottawa &amp; Allegan County</h2>
        <p class="sec-big">Local to Holland. Ready for your project.</p>
        <p>We are based in the Holland area and work in Holland and across West Michigan, on both the Ottawa County and Allegan County sides of town. Not sure we come to you? Call <a href={tel}>{business.phoneDisplay}</a> and ask.</p>
        <ul class="area-links" role="list">
          {areas.map((a) => <li><a href={entryUrl(a)}>Remodeling in {a.data.name} &rarr;</a></li>)}
          <li><a href="/service-areas/">All service areas &rarr;</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container">
      <FaqList faqs={faqs} title="Remodeling FAQs for Holland, MI homeowners" headline="Questions before you start?" />
    </div>
  </section>

  <!-- 9. Request an estimate (photo background) -->
  <section class="estimate-band" aria-label="Free remodeling estimates in Holland, MI">
    <div class="photo-cta__bg" aria-hidden="true"><ResponsiveImage src={bathImg} alt="" sizes="100vw" widths={[640, 1400]} /></div>
    <div class="container split">
      <div class="stack">
        <h2 class="sec-kw">Free remodeling estimates in Holland, MI</h2>
        <p class="sec-big">Tell us what you are building</p>
        <p class="lead">Free estimates for kitchen, bathroom and basement remodeling and finish trades in Holland, MI and West Michigan.</p>
        <ul class="checks" role="list">
          <li><strong>Free estimate,</strong> no obligation</li>
          <li><strong>Licensed</strong> Michigan builder</li>
          <li><strong>Local,</strong> owner-operated in Holland</li>
        </ul>
        <p><a class="btn btn--primary btn--big" href={tel}>Call {business.phoneDisplay}</a></p>
        <p>Or email <a href={`mailto:${business.email}`}>{business.email}</a></p>
      </div>
      <EstimateForm id="estimate" title="Get a free estimate" headingLevel={3} />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(2.5rem, 2rem + 4vw, 5.5rem) var(--space-6); }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg :global(picture) { display: block; height: 100%; }
  .hero__bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero__bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(13 13 12 / 92%) 0%, rgb(13 13 12 / 80%) 55%, rgb(13 13 12 / 70%) 100%); }
  .hero__grid { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 64rem) { .hero__grid { grid-template-columns: 1.35fr 1fr; gap: var(--space-8); } }
  .hero__kw { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-soft); margin: 0 0 var(--space-3); line-height: 1.4; }
  .hero__big { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; text-wrap: balance; font-size: clamp(2.6rem, 1.8rem + 4vw, 5rem); line-height: 0.98; margin: 0 0 var(--space-5); }
  .hero__lead { font-size: var(--text-lg); max-width: 38rem; color: var(--color-text); opacity: 0.92; }
  .eyebrow, .eyebrow--tan { color: var(--color-accent-soft); }
  .chips { list-style: none; padding: 0; margin: var(--space-5) 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chips a { display: inline-block; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border-strong); background: rgb(13 13 12 / 55%); color: var(--color-text); text-decoration: none; font-size: var(--text-sm); }
  .chips a:hover { border-color: var(--color-accent); color: var(--color-accent-text); }
  .hero__call { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); }
  .hero__call span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .btn--big { font-family: var(--font-heading); font-size: 1.35rem; text-transform: uppercase; letter-spacing: 0.04em; padding: var(--space-3) var(--space-6); border-radius: 0; }
  .btn--outline { border: 2px solid var(--color-accent); color: var(--color-accent-text); font-family: var(--font-heading); font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 0; }
  .btn--outline:hover { background: var(--color-accent); color: var(--color-on-accent); }
  .stats { list-style: none; padding: var(--space-6) 0 0; margin: var(--space-7) 0 0; border-top: 1px solid var(--color-border-strong); display: grid; gap: var(--space-5); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 48rem) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats li { display: grid; gap: 2px; }
  .stats strong { font-family: var(--font-heading); font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem); line-height: 1; color: var(--color-accent-soft); }
  .stats span { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* Section heads */
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-5); margin-bottom: var(--space-6); }
  .head-row .sec-big { max-width: 22ch; }
  .head-row .lead { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }

  /* Services: photo cards */
  .svc { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .svc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .svc { grid-template-columns: repeat(3, 1fr); } }
  .svc__card { position: relative; display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); overflow: hidden; transition: border-color var(--duration) var(--ease); }
  .svc__card:hover { border-color: var(--color-accent); }
  .svc__card :global(picture) { display: block; }
  .svc__card :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 400ms var(--ease); }
  .svc__card--lg :global(img) { aspect-ratio: 4 / 3; }
  .svc__card:hover :global(img) { transform: scale(1.04); }
  .svc__body { padding: var(--space-5); display: grid; gap: var(--space-2); }
  .svc h3 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem); margin: 0; }
  .svc h3 a { color: var(--color-text); text-decoration: none; }
  .svc h3 a::after { content: ""; position: absolute; inset: 0; }
  .svc p { margin: 0; color: var(--color-text-muted); }
  .svc__go { color: var(--color-accent-text); font-weight: 600; font-size: var(--text-sm); margin-top: var(--space-2); }
  .svc__card--cta { background: var(--color-accent); border-color: var(--color-accent); justify-content: center; }
  .svc__card--cta .svc__body { gap: var(--space-4); padding: var(--space-6); }
  .svc__card--cta p { color: var(--color-on-accent); }
  .svc__cta-h { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem); line-height: 1; }
  .svc__card--cta .btn--primary { background: var(--color-bg); color: var(--color-text); }
  .svc__card--cta .btn--primary:hover { background: #000; color: var(--color-accent-text); }
  .svc__alt { color: var(--color-on-accent); font-weight: 600; }

  /* Split media + text */
  .split { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 60rem) { .split { grid-template-columns: 1fr 1fr; gap: var(--space-8); } .split--rev .split__media { order: 2; } }
  .split__media { position: relative; }
  .split__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .badge { position: absolute; left: var(--space-4); bottom: var(--space-4); background: var(--color-accent); color: var(--color-on-accent); padding: var(--space-3) var(--space-5); display: grid; }
  .badge strong { font-family: var(--font-heading); font-size: 1.75rem; text-transform: uppercase; line-height: 1; }
  .badge span { font-size: var(--text-sm); font-weight: 600; }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .checks li { padding-left: 2rem; position: relative; }
  .checks li::before { content: ""; position: absolute; left: 0; top: 0.35em; width: 1.1rem; height: 0.6rem; border-left: 3px solid var(--color-accent); border-bottom: 3px solid var(--color-accent); transform: rotate(-45deg); }

  /* Gallery */
  .gallery { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: 1fr; grid-auto-rows: 16rem; }
  @media (min-width: 40rem) { .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 17rem; } }
  @media (min-width: 64rem) { .gallery { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 17rem; } .gallery__item--wide { grid-column: span 2; } .gallery__item--tall { grid-row: span 2; } }
  .gallery__item a { position: relative; display: block; overflow: hidden; height: 100%; color: var(--color-text); text-decoration: none; }
  .gallery__item :global(picture) { display: block; height: 100%; }
  .gallery__item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }
  .gallery__item a:hover :global(img) { transform: scale(1.04); }
  .gallery__item a::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 45%, rgb(13 13 12 / 88%)); }
  .gallery__cap { position: absolute; left: var(--space-5); right: var(--space-5); bottom: var(--space-4); z-index: 1; display: grid; gap: 2px; }
  .gallery__cap strong { font-family: var(--font-heading); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); text-transform: uppercase; line-height: 1.05; }
  .gallery__cap small { color: var(--color-accent-text); font-size: var(--text-sm); font-weight: 600; }
  .gallery__note { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-text-faint); }

  /* Photo CTA band */
  .photo-cta, .estimate-band { position: relative; isolation: isolate; overflow: hidden; }
  .photo-cta { padding-block: clamp(3rem, 2rem + 4vw, 5.5rem); }
  .estimate-band { padding-block: var(--section-y); }
  .photo-cta__bg { position: absolute; inset: 0; z-index: -1; }
  .photo-cta__bg :global(picture) { display: block; height: 100%; }
  .photo-cta__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .photo-cta__bg::after { content: ""; position: absolute; inset: 0; background: rgb(13 13 12 / 82%); }
  .estimate-band .photo-cta__bg::after { background: linear-gradient(90deg, rgb(13 13 12 / 94%), rgb(13 13 12 / 84%)); }
  .photo-cta__inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-5); }
  .photo-cta__h { margin: 0; font-family: var(--font-heading); font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem); font-weight: 700; text-transform: uppercase; line-height: 1.05; }
  .photo-cta__h a { color: var(--color-accent-text); text-decoration: none; white-space: nowrap; }

  /* Steps */
  .steps { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: grid; gap: var(--space-4); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start; padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .steps__n { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--color-accent); color: var(--color-on-accent); }
  .steps h3 { margin: 0 0 var(--space-1); font-size: 1.5rem; }
  .steps p { color: var(--color-text-muted); margin: 0; }

  /* Reviews */
  .reviews { display: grid; gap: var(--space-6); }
  @media (min-width: 60rem) { .reviews { grid-template-columns: 1fr 1fr; align-items: center; } }
  .reviews__links { display: grid; gap: var(--space-3); }
  .social { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); text-decoration: none; }
  .social:hover { border-color: var(--color-accent); }
  .social strong { font-family: var(--font-heading); font-size: 1.75rem; text-transform: uppercase; }
