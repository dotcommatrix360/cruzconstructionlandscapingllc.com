---
// Feedback ("How did we do?"): where the business card and thank-you card QR codes land (/feedback/).
// Flow from the agency presentation: "What was your experience like?" → 4–5 stars: thank you + open the public
// review page (Google once business.reviewLinks.google is set, else Facebook); 1–3 stars: a private feedback form so
// Miguel can make it right. Owner's choice (2026-11-02): the low-rating screen has no public review link. Note: Google
// prohibits review gating, which can get reviews removed; add the link back if that becomes a concern. noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import bgImg from '../assets/images/kitchen-white-cabinets.jpg';
import { config, business } from '../lib/site';
const links = business.reviewLinks || {};
const reviewUrl = links.google || links.facebook || '';
const reviewSite = links.google ? 'Google' : 'Facebook';
const form = config.integrations.form || { provider: 'none' };
const posts = (form.provider === 'formspree' || form.provider === 'custom') && form.action;
---
<BaseLayout title="Share Your Experience" description="Thanks for choosing Cruz Construction & Landscaping. Tell us how we did: your feedback helps a small local business." noindex>
  <section class="review">
    <div class="review__bg" aria-hidden="true"><ResponsiveImage src={bgImg} alt="" priority sizes="100vw" widths={[640, 960, 1400]} /></div>
    <div class="container review__inner">
      <img class="review__logo" src="/logo.png" alt="Cruz Construction & Landscaping LLC" width="420" height="250" />

      <!-- 1. Rating -->
      <div class="review__card" data-step="rate">
        <p class="review__eyebrow">How did we do?</p>
        <h1 class="review__q">What was your experience like working with Cruz Construction?</h1>
        <div class="stars" role="radiogroup" aria-label="Your rating, 1 to 5 stars">
          {[1, 2, 3, 4, 5].map((n) => (
            <button type="button" class="star" role="radio" aria-checked="false" aria-label={`${n} star${n === 1 ? '' : 's'}`} data-star={n}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>
            </button>
          ))}
        </div>
        <p class="review__sub">Thanks for your business! Your feedback helps us improve our service.</p>
      </div>

      <!-- 2a. Happy: thank you + the review site -->
      <div class="review__card" data-step="happy" hidden>
        <p class="review__q">Thank you!</p>
        <p class="review__sub">We are taking you to {reviewSite} so you can share your experience. If it does not open, use the button below.</p>
        {reviewUrl && <a class="review__btn" href={reviewUrl} target="_blank" rel="noopener" data-review-link>Share on {reviewSite}</a>}
      </div>

      <!-- 2b. Not happy: private feedback form -->
      <div class="review__card" data-step="sorry" hidden>
        <p class="review__q">We are sorry we missed the mark.</p>
        <p class="review__sub">Tell us what happened and Miguel will reach out personally to make it right.</p>
        <form class="review__form" method={posts ? 'post' : undefined} action={posts ? form.action : undefined} data-mailto={posts ? undefined : business.email}>
          <input type="hidden" name="rating" data-rating-field />
          <div class="field"><label for="fb-name">Your name</label><input id="fb-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="fb-email">Email address</label><input id="fb-email" name="email" type="email" autocomplete="email" required /></div>
          <!-- No phone field: the chat widget must be the only phone/SMS opt-in on the site (A2P 10DLC). -->
          <div class="field"><label for="fb-msg">What went wrong?</label><textarea id="fb-msg" name="message" rows="4" required></textarea></div>
          {posts && <div class="field field--hp" aria-hidden="true"><label for="fb-hp">Leave this empty</label><input id="fb-hp" name="_gotcha" tabindex="-1" autocomplete="off" /></div>}
          <button class="review__btn" type="submit">Send feedback</button>
        </form>
      </div>

      <!-- 3. Feedback sent -->
      <div class="review__card" data-step="sent" hidden>
        <p class="review__q">Thank you for telling us.</p>
        <p class="review__sub">Your feedback goes straight to Miguel. He will reach out to you to make it right.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const steps = document.querySelectorAll<HTMLElement>('[data-step]');
  const show = (name: string) => steps.forEach((s) => { s.hidden = s.dataset.step !== name; });
  const stars = [...document.querySelectorAll<HTMLButtonElement>('[data-star]')];
  const reviewLink = document.querySelector<HTMLAnchorElement>('[data-review-link]');
  const ratingField = document.querySelector<HTMLInputElement>('[data-rating-field]');
  const paint = (n: number) => stars.forEach((s) => s.classList.toggle('is-on', Number(s.dataset.star) <= n));

  stars.forEach((s) => {
    const n = Number(s.dataset.star);
    s.addEventListener('mouseenter', () => paint(n));
    s.addEventListener('mouseleave', () => paint(Number(ratingField?.value || 0)));
    s.addEventListener('click', () => {
      stars.forEach((x) => x.setAttribute('aria-checked', String(x === s)));
      if (ratingField) ratingField.value = String(n);
      paint(n);
      setTimeout(() => {
        if (n >= 4) {
          show('happy');
          if (reviewLink) setTimeout(() => { location.href = reviewLink.href; }, 1500); // the button stays as a fallback
        } else show('sorry');
      }, 250);
    });
  });

  // Feedback form: posts to the form endpoint when one is set; until then it hands the message to the email app.
  const form = document.querySelector<HTMLFormElement>('.review__form');
  form?.addEventListener('submit', (e) => {
    if (!form.dataset.mailto) return; // real endpoint: normal submit
    e.preventDefault();
    const d = new FormData(form);
    const body = `Rating: ${d.get('rating')} of 5\nName: ${d.get('name')}\nEmail: ${d.get('email')}\n\nWhat went wrong:\n${d.get('message')}`;
    location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent('Customer feedback from the website')}&body=${encodeURIComponent(body)}`;
    show('sent');
  });
</script>

<style>
  .review { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100dvh - var(--header-h)); padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(3rem, 2rem + 5vw, 6rem); background: var(--color-bg); }
  .review__bg { position: absolute; inset: 0; z-index: -1; }
  .review__bg :global(picture) { display: block; height: 100%; }
  .review__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .review__bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 13 12 / 72%) 0%, rgb(13 13 12 / 86%) 55%, rgb(13 13 12 / 95%) 100%); }
  .review__inner { max-width: 34rem; display: grid; justify-items: center; }
  .review__logo { width: min(13rem, 60%); height: auto; margin-bottom: var(--space-6); }
  .review__card { width: 100%; min-width: 0; background: rgb(21 21 19 / 92%); backdrop-filter: blur(6px); border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); text-align: center; display: grid; gap: var(--space-4); box-shadow: var(--shadow-lg); }
  .review__card[hidden] { display: none; }
  .review__q { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.2rem); line-height: 1.05; margin: 0; text-wrap: balance; }
  .review__sub { color: var(--color-text-muted); margin: 0; }
  .stars { display: flex; justify-content: center; gap: clamp(2px, 1vw, var(--space-2)); }
  .star { width: clamp(40px, 11vw, 52px); height: clamp(40px, 11vw, 52px); padding: 3px; border: 0; background: none; cursor: pointer; color: var(--color-border-strong); transition: transform var(--duration) var(--ease), color var(--duration) var(--ease); }
  .star svg { width: 100%; height: 100%; fill: currentColor; }
  .star.is-on { color: var(--color-accent); }
  .star:hover { transform: scale(1.12); }
  .review__btn { display: flex; align-items: center; justify-content: center; min-height: 56px; padding: var(--space-3) var(--space-5); background: var(--color-accent); color: var(--color-on-accent); border: 0; border-radius: var(--radius); font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem; text-transform: uppercase; letter-spacing: .03em; text-decoration: none; cursor: pointer; width: 100%; }
  .review__btn:hover { background: var(--color-accent-hover); color: var(--color-on-accent); }
  .review__form { display: grid; gap: var(--space-3); text-align: left; }
  .field { display: grid; gap: var(--space-1); }
  .field label { font-size: var(--text-sm); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-muted); }
  .field input, .field textarea { padding: var(--space-3); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); font: inherit; width: 100%; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 2px var(--color-accent); }
  .field--hp { position: absolute; left: -9999px; }
  .review__eyebrow { margin: 0; font-size: var(--text-sm); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent-soft); }
</style>
