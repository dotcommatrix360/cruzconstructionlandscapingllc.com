---
// Review us: where the business card and thank-you card QR codes land (they point straight at /review-us/). Hidden from Google:
// it is for customers, not for ranking. Every visitor gets the same review buttons (no review gating: Google
// forbids sending only happy customers to Google). Buttons come from site.config.json → business.reviewLinks.
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../lib/site';
const links = business.reviewLinks || {};
const first = 'Miguel';
---
<BaseLayout title="Review Us" description="Thanks for choosing Cruz Construction & Landscaping. Leave a quick review on Google or Facebook to help a small local business." noindex>
  <section class="review">
    <div class="container review__inner">
      <img class="review__logo" src="/logo.png" alt="Cruz Construction & Landscaping LLC" width="420" height="250" />
      <h1 class="sec-kw">Review Cruz Construction</h1>
      <p class="sec-big">Thank you for choosing us!</p>
      <p class="lead">A quick review helps a small local business more than you know, and helps your neighbors find a contractor they can trust. It takes about 30 seconds.</p>
      <div class="review__buttons">
        {links.google && (
          <a class="review__btn review__btn--google" href={links.google} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.9-3a7.2 7.2 0 0 1-10.7-3.8H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8z"/></svg>
            Review us on Google
          </a>
        )}
        {links.facebook && (
          <a class="review__btn review__btn--facebook" href={links.facebook} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
            Review us on Facebook
          </a>
        )}
      </div>
      <p class="review__note">Something not right? Call or text {first} at <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a> and we'll make it right.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .review { padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 5vw, 6rem); background: radial-gradient(120% 80% at 50% 0%, var(--color-surface-strong), var(--color-bg) 70%); }
  .review__inner { max-width: 36rem; text-align: center; display: grid; justify-items: center; }
  .review__logo { width: min(15rem, 70%); height: auto; margin-bottom: var(--space-6); }
  .review .sec-kw::before { margin-inline: auto; }
  .review .lead { max-width: 32rem; }
  .review__buttons { display: grid; gap: var(--space-3); width: 100%; max-width: 24rem; margin-top: var(--space-5); }
  .review__btn { display: flex; align-items: center; justify-content: center; gap: var(--space-3); min-height: 60px; padding: var(--space-3) var(--space-5); font-family: var(--font-heading); font-weight: 700; font-size: 1.35rem; text-transform: uppercase; letter-spacing: .03em; text-decoration: none; border-radius: var(--radius); transition: transform var(--duration) var(--ease), background-color var(--duration) var(--ease); }
  .review__btn:hover { transform: translateY(-2px); }
  .review__btn--google { background: #ffffff; color: #1f1f1f; }
  .review__btn--google:hover { background: #f1f1f1; color: #1f1f1f; }
  .review__btn--facebook { background: #1877f2; color: #ffffff; }
  .review__btn--facebook:hover { background: #166fe5; color: #ffffff; }
  .review__note { margin-top: var(--space-7); font-size: var(--text-sm); color: var(--color-text-muted); }
  .review__note a { white-space: nowrap; }
</style>
