---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { business } from '../lib/site';
---
<BaseLayout title="Free Estimate | Contact Cruz Construction" description="Request a free estimate for kitchen, bathroom or basement remodeling in Holland, MI. Call 616-502-1874, email, or send the three-field form.">
  <section class="section">
    <div class="container">
      <h1>Get a free remodeling estimate in Holland, MI</h1>
      <p class="lead measure">Tell us what you are building or fixing in Holland or West Michigan. Call, email or send the form and we will get back to you.</p>
      <div class="form-wrap"><EstimateForm id="estimate" title="Send your project" /></div>
      <div class="ways">
        <a class="way way--main" href={`tel:${business.phone}`}><small>Call</small><span>{business.phoneDisplay}</span></a>
        <a class="way" href={`mailto:${business.email}?subject=Estimate%20request`}><small>Email</small><span>{business.email}</span></a>
      </div>
      <div class="info">
        <p><strong>Working hours</strong><br />7am to 5pm</p>
        <p><strong>Service area</strong><br />Holland, MI &amp; West Michigan</p>
        <p><strong>License</strong><br />Michigan Builders License</p>
        <p><strong>Follow our work</strong><br />{(business.sameAs || []).map((u, i) => <><a href={u} target="_blank" rel="noopener">{u.includes('facebook') ? 'Facebook' : u.includes('instagram') ? 'Instagram' : 'TikTok'}</a>{i < (business.sameAs || []).length - 1 ? ' · ' : ''}</>)}</p>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .ways { display: grid; gap: var(--space-4); margin-block: var(--space-7); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .way { display: grid; gap: var(--space-2); padding: var(--space-6); border: 1px solid var(--color-border); background: var(--color-surface); text-decoration: none; color: var(--color-text); overflow-wrap: anywhere; }
  .way small { font-size: var(--text-sm); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); }
  .way span { font-family: var(--font-heading); font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem); font-weight: 700; line-height: 1; }
  .way--main { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .way--main small { color: var(--color-on-accent); }
  .way:hover:not(.way--main) { border-color: var(--color-accent); }
  .way--main:hover { background: var(--color-accent-hover); }
  .form-wrap { max-width: 36rem; margin-top: var(--space-6); }
  .info { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .info p { margin: 0; }
</style>
