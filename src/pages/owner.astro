---
// Owner guide for Miguel: how to use the system (app, inbox, CRM, pipeline, review requests).
// noindex, minimal layout, no chat, not linked anywhere, not in the sitemap, NOT listed in robots.txt
// (that file is public and would reveal the path). Password later via Cloudflare Access on /owner*.
// Videos: drop MP4s in public/videos/owner/<slug>.mp4 and set `ready: true` below.
import BaseLayout from '../layouts/BaseLayout.astro';

const videos = [
  { slug: 'find-your-way', group: 'start', title: 'Find my way around the app', ready: true, what: 'Home, the bottom bar, where everything is.' },
  { slug: 'reply-text', group: 'inbox', title: 'Reply to a text', ready: true, what: 'Answer a customer from your business number.' },
  { slug: 'send-email', group: 'inbox', title: 'Send an email', ready: true, what: 'Switch the reply box from SMS to Email.' },
  { slug: 'call-customer', group: 'inbox', title: 'Call a customer', ready: true, what: 'Call from the app with your business number.' },
  { slug: 'add-customer', group: 'contacts', title: 'Add a new customer', ready: true, what: 'Name, phone, address, save.' },
  { slug: 'add-note', group: 'contacts', title: 'Add a note to a customer', ready: true, what: 'Write down what you saw on a site visit.' },
  { slug: 'edit-contact', group: 'contacts', title: 'Edit a contact', ready: true, what: 'Fix a name, phone or address.' },
  { slug: 'move-job', group: 'jobs', title: 'Move a job to the next step', ready: true, what: 'Change the stage of a job in your Jobs Pipeline.' },
  { slug: 'review-pipeline', group: 'reviews', title: 'Ask for a review (finished job)', ready: true, what: 'Move the job to "Completed - Send Review".' },
  { slug: 'review-form', group: 'reviews', title: 'Ask for a review (no job card)', ready: true, what: 'Fill in name and phone on your customer form.' },
  { slug: 'block-spam', group: 'contacts', title: 'Stop a spammer (DND)', ready: true, what: 'Turn on Do Not Disturb for a spam number.' },
];

const videoGroups = [
  { key: 'start', title: 'Start here', what: 'A quick tour of the app.' },
  { key: 'inbox', title: 'Talk to customers', what: 'Texts, emails and calls from your business number. All in Conversations.' },
  { key: 'contacts', title: 'Your customer list (Contacts)', what: 'Everyone who ever called, texted or filled in a form.' },
  { key: 'jobs', title: 'Your jobs (Opportunities)', what: 'Every job as a card. Move it as the job moves forward.' },
  { key: 'reviews', title: 'Get Google reviews', what: 'Do this when a job is done.' },
];

const steps = [
  ['New lead (form or chat)', 'They get an instant text. You get an alert. <strong>Call them same day.</strong>'],
  ['Missed call', 'They get an auto text. You get an alert. Call back when free.'],
  ['New text', 'You get an alert. Reply in the app.'],
  ['Job moves forward', 'Change its stage in <strong>Opportunities</strong>.'],
  ['Job finished', 'Move it to <strong>Completed - Send Review</strong>. Reviews + 1-year follow-up start on their own.'],
  ['No job card?', 'Use <a href="/marketing-form/">the customer form</a> instead.'],
  ['1 to 3 stars', 'It does NOT go to Google. You get an alert. <strong>Call them that day.</strong>'],
];

const textGroups = [
  { title: 'Missed call', when: 'Someone calls and you miss it.', on: true, msgs: [
    ['1 minute later', "Hey, sorry I missed your call! I'm probably on a job site right now, but I'll get back to you as soon as I can. If you want to send me a few details about the project in the meantime, you can do that here: cruzconstructionlandscapingllc.com/contact - Miguel from Cruz Construction & Landscaping LLC"],
    ['2 minutes later', "Looking forward to hearing from you! In the meantime, are there any quick questions I can answer for you here?"],
  ], you: 'Missed call: [name] [phone]. We texted them you\'ll call back.' },
  { title: 'Website form', when: 'Someone asks for a quote on your website.', on: true, msgs: [
    ['Right away', "Hey [first name]! Just got your quote request, thanks for reaching out. I'll be in touch shortly to go over the details. - Miguel from Cruz Construction & Landscaping LLC"],
    ['Right after', "If you have any photos of the space, feel free to send them here. It helps me give you a more accurate quote. Talk soon!"],
  ], you: 'New website form lead: [name] [phone] + their message.' },
  { title: 'Website chat', when: 'Someone uses the chat bubble on your website.', on: true, msgs: [
    ['Right away', "Hey [first name]! Just got your message through the website, thanks for reaching out :) I'll get back to you as soon as I'm free. - Miguel from Cruz Construction & Landscaping LLC"],
    ['Right after', "By the way, if you have any other questions in the meantime, feel free to text me right here!"],
  ], you: 'New chat lead: [name] [phone] + their message.' },
  { title: 'Facebook / Instagram message', when: 'Someone messages your page (after you connect them).', on: true, msgs: [
    ['Right away', "Hey [first name]! Thanks for contacting us here at Cruz Construction & Landscaping LLC. I'm a little slow to respond via social media, but I will get back to you as soon as I can. If you ever want to text me directly at 616-344-5421, that would be awesome. PS: This is an automated txt but I will read it and get back to you as soon as I have a free second:)! Talk soon! - Miguel"],
  ], you: 'New Facebook message: [name] + their message.' },
  { title: 'Discount request', when: 'Someone fills in the 10% discount form.', on: true, msgs: [
    ['Right away', "Hey [first name]! Just got your discounted job request! I'll be in touch shortly and get you that discount!"],
  ], you: '10% discount lead: [name] [phone] + their message.' },
  { title: 'Review request', when: 'You move a job to Completed - Send Review (or use the customer form). Stops as soon as they tap the link.', on: true, msgs: [
    ['Right away', "Hey [first name], this is Miguel from Cruz Construction & Landscaping LLC! I hope you had a great experience with us. We donate a meal to someone in need for every customer who takes 10 seconds to leave a review. Here's the link: [review link]"],
    ['If no review', "Hey [first name]! Just following up since I saw you haven't had a chance to leave a review yet. For every review we get, we donate a meal to someone in need, so if you've got 10 seconds it really goes a long way. Here's the link: [review link] P.S. Just reply \"stop\" if you'd rather I don't text you about this."],
    ['If no review', "Hey [first name], little reminder in case you got busy this week! We still give a free meal to someone in need for every new review. Here's the link again: [review link]"],
    ['Last one', "Hey [first name]! This is the last time I'll ask, I promise :) If you have a sec to leave a review, we'll donate a meal to someone in need. Thanks so much either way, it was great working with you! [review link]"],
  ], you: '1 to 3 stars: Unhappy customer: [name] [phone] + their feedback. It does NOT go to Google.' },
  { title: 'Past customers: 1-year follow-up', when: 'Starts about 1 month after a finished job, then about every 3 months. 10% off, link to your discount page.', on: true, msgs: [
    ['~1 month', "Hey [first name]! I'm running a season special this week and giving 10% off. It's only for the first three people, so if you're interested (or know someone who might be), just tap this link: cruzconstructionlandscapingllc.com/get-your-discount - Miguel from Cruz Construction & Landscaping LLC"],
    ['8 weeks later', "Hey [first name], hope all's well! I'm running a customer anniversary special for the next 6 days and giving 10% off. If you've got a project in mind (or know someone who does), here's the link: cruzconstructionlandscapingllc.com/get-your-discount - Miguel from Cruz Construction & Landscaping LLC"],
    ['~3 months later', "Hey [first name]! Quick one, I'm doing a loyalty special this week for past customers: 10% off. Only taking the first three people, so if you're thinking about anything around the house (or know someone who is), tap here: cruzconstructionlandscapingllc.com/get-your-discount - Miguel"],
    ['~3 months later', "Hey [first name], it's Miguel! We've got a few openings coming up, so I'm giving 10% off to the first four people this week. If you've been putting off a project (or a friend has), now's a good time: cruzconstructionlandscapingllc.com/get-your-discount"],
    ['~3 months later', "Hey [first name]! It's been a while, hope you're still loving the work we did. I'm running an anniversary special for the next 6 days, 10% off. If you or someone you know needs anything, just tap here: cruzconstructionlandscapingllc.com/get-your-discount - Miguel"],
  ], you: 'If they reply, you get a text with their answer and their number.' },
  { title: 'Old customer list (one-time blast)', when: 'OFF. Only when you say go, to your whole past customer list.', on: false, msgs: [
    ['Day 1', "Hey [first name], it's Miguel from Cruz Construction & Landscaping LLC. Wanted to reach out because my team and I are running a special this week and giving up to $1,000 off remodeling projects. Only catch is we can only take on 3 clients, so I thought of you first. Let me know if you're interested, no worries either way!"],
    ['Next day, if no reply', "Hey [first name], did you get my text yesterday? We've only got 2 spots left for the up to $1,000 off. Just reply \"yes\" or \"no\" so I know whether to save you a spot. Have a great day!"],
  ], you: '' },
];
---
<BaseLayout title="Owner Guide" description="Owner guide for Cruz Construction: how to use the app, the inbox, the pipeline and review requests." noindex noChat minimal>
  <section class="og">
    <div class="container og__inner">
      <img class="og__logo" src="/logo.png" alt="Cruz Construction & Landscaping LLC" width="420" height="250" />
      <h1 class="og__title">Owner guide</h1>
      <a class="og__help" href="sms:+18882773619">Need help or something looks weird? Text Visar: <strong>(888) 277-3619</strong></a>
      <p class="og__lead og__nums">Your business number (on the website): <strong>616-344-5421</strong>. Calls to it ring your cell: <strong>616-502-1874</strong>.</p>
      <p class="og__lead">Every Thursday evening Visar texts you to ask how your week went and which jobs you finished. Just reply: it goes straight to him.</p>

      <section id="scams" class="og__card og__warn">
        <h2>Watch out: spam and scams</h2>
        <p>Now that you are online, bots and scammers will text, email and call you. <strong>Do not reply and do not click their links.</strong></p>
        <ul>
          <li>"Your website is broken", "Your SEO is failing", "You're missing on Google", "Claim your listing", "Your domain is expiring": all automated bots fishing for a reply.</li>
          <li>Texts: don't answer. Turn on <strong>Do Not Disturb</strong> for that number (see the "Stop a spammer" video).</li>
          <li>Spam calls: we can't fully stop them. Don't engage. Tell them: "Don't call me again or I'll report you," then hang up.</li>
          <li>Not sure if it's real? Text Visar before you do anything.</li>
        </ul>
      </section>

      <!-- TEMPORARY: remove this section once Miguel has connected Facebook + Instagram. -->
      <section id="connect-social" class="og__card og__todo">
        <h2>One-time setup: connect Facebook &amp; Instagram</h2>
        <p>Do this once on a <strong>computer</strong> so your Facebook and Instagram messages show up in your app with your texts. Takes about 2 minutes.</p>
        <video controls preload="none" playsinline poster="/videos/owner/connect-fb-ig.jpg" src="/videos/owner/connect-fb-ig.mp4" width="1568" height="798"></video>
        <p class="og__vhint">After you connect them, this section will be removed.</p>
      </section>

      <section id="videos" class="og__card">
        <h2>What do you want to do?</h2>
        <p class="og__vhint">Tap the one you need. 10 to 20 seconds each.</p>
        {videoGroups.map((grp) => (
          <div class="og__vg">
            <h3 class="og__vgt">{grp.title}</h3>
            <p class="og__vgw">{grp.what}</p>
            <div class="og__videos">
              {videos.filter((v) => v.group === grp.key).map((v) => (
                <article class="og__video">
                  {v.ready
                    ? <video controls preload="none" playsinline poster={`/videos/owner/${v.slug}.jpg`} src={`/videos/owner/${v.slug}.mp4`} width="390" height="924" />
                    : <div class="og__soon" aria-hidden="true">Video coming soon</div>}
                  <h3>{v.title}</h3>
                  <p>{v.what}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section id="how" class="og__card">
        <h2>How it works</h2>
        <dl class="og__how">
          {steps.map(([t, d]) => (<><dt>{t}</dt><dd set:html={d} /></>))}
        </dl>
      </section>

      <section id="texts" class="og__card">
        <h2>Your automatic texts</h2>
        <p class="og__vhint">What customers get, word for word, from your business number. Want different wording? Tell Visar.</p>
        {textGroups.map((g, gi) => (
          <div class="og__tg">
            <h3>{gi + 1}. {g.title} {!g.on && <span class="og__off">OFF</span>}</h3>
            <p class="og__when">{g.when}</p>
            <ol class="og__msgs">
              {g.msgs.map(([t, m]) => (<li><span class="og__t">{t}</span><span class="og__m">"{m}"</span></li>))}
            </ol>
            {g.you && <p class="og__you"><strong>You get:</strong> {g.you}</p>}
          </div>
        ))}
      </section>


    </div>
  </section>
</BaseLayout>
<style>
  .og { padding-block: clamp(2rem, 1.5rem + 3vw, 4rem); background: var(--color-bg); min-height: 100dvh; }
  .og__inner { max-width: 46rem; display: grid; gap: var(--space-5); }
  .og__logo { width: min(10rem, 45%); height: auto; justify-self: center; }
  .og__eyebrow { margin: 0; text-align: center; font-size: var(--text-sm); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent-soft); }
  .og__title { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1; margin: 0; text-align: center; }
  .og__help { justify-self: center; text-align: center; padding: 10px 18px; border: 2px solid var(--color-accent); border-radius: 999px; color: var(--color-text); text-decoration: none; }
  .og__help strong { color: var(--color-accent); white-space: nowrap; }
  .og__how { margin: 0; display: grid; grid-template-columns: minmax(8rem, 11rem) 1fr; gap: 10px 16px; }
  .og__how dt { font-weight: 700; }
  .og__how dd { margin: 0; color: var(--color-text-muted); }
  .og__how dd a { color: var(--color-accent); }
  @media (max-width: 480px) { .og__how { grid-template-columns: 1fr; gap: 2px; } .og__how dd { margin-bottom: 10px; } }
  .og__todo { border-top-color: #2e90fa; }
  .og__todo video { display: block; width: 100%; height: auto; margin: var(--space-3) 0; background: #0d0d0c; border: 1px solid var(--color-border); }
  .og__nums strong { color: var(--color-accent); white-space: nowrap; }
  .og__warn { border-top-color: #d92d20; }
  .og__warn ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 8px; }
  .og__lead { margin: 0; text-align: center; color: var(--color-text-muted); }
  .og__toc { display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: center; }
  .og__toc a { padding: 6px 12px; border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--text-sm); text-decoration: none; color: var(--color-text); }
  .og__toc a:hover { border-color: var(--color-accent); }
  .og__card { background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); scroll-margin-top: 1rem; }
  .og__card h2 { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem); line-height: 1.05; margin: 0 0 var(--space-3); display: flex; align-items: center; gap: var(--space-3); }
  .og__card p { margin: 0 0 var(--space-3); }
  .og__card p:last-child { margin-bottom: 0; }
  .og__card a { color: var(--color-accent); }
  .og__num { display: inline-grid; place-items: center; width: 2rem; height: 2rem; flex: none; border-radius: 50%; background: var(--color-accent); color: var(--color-on-accent); font-size: 1.1rem; }
  .og__videos { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .og__video video { display: block; width: 100%; height: auto; aspect-ratio: 390 / 924; max-height: 34rem; object-fit: contain; background: #0d0d0c; border: 1px solid var(--color-border); }
  .og__soon { width: 100%; height: 4.5rem; background: #0d0d0c; border: 1px dashed var(--color-border); }
  .og__soon { display: grid; place-items: center; color: var(--color-text-muted); font-size: var(--text-sm); }
  .og__video h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1rem; margin: var(--space-2) 0 var(--space-1); }
  .og__vhint { margin: 0 0 var(--space-3); color: var(--color-text-muted); }
  .og__video p { display: none; }
  .og__tg { padding: var(--space-3) 0; border-top: 1px solid var(--color-border); }
  .og__tg h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.15rem; margin: 0 0 4px; }
  .og__off { font-size: .75rem; padding: 2px 8px; border-radius: 999px; background: #d92d20; color: #fff; vertical-align: middle; }
  .og__when { margin: 0 0 var(--space-2) !important; color: var(--color-text-muted); font-size: var(--text-sm); }
  .og__msgs { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .og__msgs li { display: grid; gap: 2px; padding: 10px 12px; background: var(--color-bg); border-left: 3px solid var(--color-accent); }
  .og__t { font-size: var(--text-sm); font-weight: 700; color: var(--color-accent); }
  .og__m { line-height: 1.45; overflow-wrap: anywhere; }
  .og__you { margin: var(--space-2) 0 0 !important; font-size: var(--text-sm); color: var(--color-text-muted); }
  .og__vg { padding-top: var(--space-4); margin-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .og__vg:first-of-type { margin-top: 0; }
  .og__vgt { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.25rem; color: var(--color-accent); margin: 0 0 2px; }
  .og__vgw { margin: 0 0 var(--space-3) !important; color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
