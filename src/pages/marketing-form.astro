---
// Internal page for the owner (Miguel): add a finished customer. The GHL form starts the review request and the
// 1-year follow-up sequence. noindex, no nav/footer, no chat, not linked anywhere, not in the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';
import GhlForm from '../components/GhlForm.astro';
---
<BaseLayout title="Add a Finished Customer" description="Internal form: add a finished Cruz Construction customer to start the review request and 1-year follow-up." noindex noChat minimal>
  <section class="mf">
    <div class="container mf__inner">
      <img class="mf__logo" src="/logo.png" alt="Cruz Construction & Landscaping LLC" width="420" height="250" />
      <h1 class="mf__title">Add a finished customer</h1>
      <div class="mf__card">
        <GhlForm formId="XlcBPFO1AcZMCQbV5int" formName="Client Review + 1 Year Followup Sequence Form" height={900} />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .mf { padding-block: clamp(2rem, 1.5rem + 3vw, 4rem); background: var(--color-bg); min-height: 100dvh; }
  .mf__inner { max-width: 40rem; display: grid; justify-items: center; }
  .mf__logo { width: min(11rem, 50%); height: auto; margin-bottom: var(--space-5); }
  .mf__title { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1; margin: 0 0 var(--space-5); text-align: center; }
  .mf__card { width: 100%; background: var(--color-surface); border: 1px solid var(--color-border); border-top: 4px solid var(--color-accent); padding: clamp(1rem, 0.75rem + 1.5vw, 1.75rem); }
</style>
